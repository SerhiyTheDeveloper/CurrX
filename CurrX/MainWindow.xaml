<Window x:Class="CurrX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CurrX"
        Width="960" Height="760"
        MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ===== Кольори ===== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0B4F8A"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3EFFB"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#DCEBFA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5B6168"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E1E3E6"/>
        <SolidColorBrush x:Key="ControlLineBrush" Color="#C4C7CC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA"/>

        <!-- ===== Картка ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ===== Текст ===== -->
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===== Кнопки ===== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="OutlineAccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- ===== Поля введення ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlLineBrush}"/>
        </Style>

        <!-- ===== Таблиця ===== -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Основний вміст ================= -->
        <Grid Grid.Row="0" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Шапка ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Курс обміну валют" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Офіційний курс гривні · джерело: bank.gov.ua (Національний банк України)"
                               FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <!-- Статус -->
                <Border x:Name="statusBorder" Grid.Column="1" Margin="16,0,0,0" MaxWidth="460" VerticalAlignment="Bottom"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="4" Padding="10,5">
                    <TextBlock x:Name="statusLabel" Text="Дані ще не завантажено"
                               FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentDarkBrush}"/>
                </Border>
            </Grid>

            <!-- ===== Картка: поточні дані ===== -->
            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource Card}">
                <StackPanel>

                    <!-- Керування: валюта, завантаження, файли -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Валюта" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="currencyCombo" Width="170"/>

                            </StackPanel>
                            <Button x:Name="loadButton" Content="Завантажити з інтернету"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom"
                                    Click="loadButton_Click"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button x:Name="saveButton" Content="Зберегти у файл"
                                    Style="{StaticResource BaseButton}"
                                    IsEnabled="False"
                                    Click="saveButton_Click"/>
                            <Button x:Name="openButton" Content="Відкрити файл"
                                    Style="{StaticResource BaseButton}"
                                    Margin="8,0,0,0"
                                    Click="openButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,14"/>

                    <!-- Чотири поля: рівні колонки -->
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Код валюти" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="codeLabel" Text="—" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Назва" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="nameLabel" Text="—" Style="{StaticResource StatValue}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Курс до гривні" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="rateLabel" Text="—" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Дата" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="dateLabel" Text="—" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,14"/>

                    <!-- Підказка і збереження в базу -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Поточні дані ще не збережено в базі. Нічого не зберігається автоматично."
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"/>
                        <Button x:Name="saveToDatabaseButton" Grid.Column="1" Margin="12,0,0,0"
                                Content="Зберегти поточні дані в базі"
                                Style="{StaticResource OutlineAccentButton}"
                                IsEnabled="False"
                                Click="saveToDatabaseButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Картка: збережені записи ===== -->
            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок списку -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Збережені записи" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="countLabel" Text="Записів: 0" Margin="10,0,0,0"
                                       VerticalAlignment="Bottom" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Button x:Name="refreshDatabaseButton" Grid.Column="1"
                                Content="Оновити список" Height="30" Padding="12,0" FontSize="13"
                                Style="{StaticResource BaseButton}"
                                IsEnabled="False"
                                Click="refreshDatabaseButton_Click"/>
                    </Grid>

                    <!-- Таблиця: розтягується на весь вільний простір -->
                    <DataGrid x:Name="savedGrid" Grid.Row="1" Margin="0,12,0,12" MinHeight="120"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderBrush="{StaticResource LineBrush}"
                              Background="{StaticResource SurfaceBrush}"
                              RowHeight="34"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              SelectionChanged="savedGrid_SelectionChanged">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DCEBFA"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DCEBFA"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2328"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2328"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Width="56"
                                                Binding="{Binding Id}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Код" Width="72"
                                                Binding="{Binding CurrencyCode}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Назва" MinWidth="140" Width="Auto"
                                                Binding="{Binding CurrencyName}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Курс, ₴" Width="120"
                                                Binding="{Binding Rate, StringFormat={}{0:F4}, ConverterCulture=uk-UA}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Дата" Width="120"
                                                Binding="{Binding DateText}"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Примітка" Width="1.5*" MinWidth="120"
                                                Binding="{Binding Notes}"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Редагування вибраного запису -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Примітка (до 500 символів)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="notesTextBox" MaxLength="500" IsEnabled="False"/>
                        </StackPanel>

                        <Button x:Name="updateButton" Grid.Column="1" Content="Зберегти зміни"
                                Margin="12,0,0,0" VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Click="updateButton_Click"/>

                        <Button x:Name="deleteButton" Grid.Column="2" Content="Видалити"
                                Margin="12,0,0,0" VerticalAlignment="Bottom"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="deleteButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
